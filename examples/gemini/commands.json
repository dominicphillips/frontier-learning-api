{
  "fixtureOnly": "The example resource is synthetic. Import it with method fixture into temporary storage only. No source page is fetched.",
  "commands": {
    "serve": [
      "uv",
      "run",
      "frontier-learning-api",
      "--data-dir",
      "data",
      "--host",
      "127.0.0.1",
      "--port",
      "8000"
    ],
    "validateFixture": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "validate",
      "examples/gemini/collection.fixture.json"
    ],
    "importFixture": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "--snapshot",
      "/tmp/gemini-academy-example/snapshot.json",
      "import",
      "examples/gemini/collection.fixture.json",
      "--method",
      "fixture"
    ],
    "parseSavedPage": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "parse",
      "tests/fixtures/pages/course_templates__1401.html",
      "--url",
      "https://www.skills.google/course_templates/1401"
    ],
    "discover": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "discover",
      "--live"
    ],
    "livePass": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "--snapshot",
      "data/gemini.json",
      "--state-dir",
      "data/collector",
      "run",
      "--live"
    ],
    "validateSnapshot": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "validate-snapshot",
      "data/gemini.json"
    ],
    "purgeCache": [
      "uv",
      "run",
      "frontier-learning-collect",
      "--provider",
      "gemini",
      "purge-cache",
      "--live"
    ],
    "regenerateSchemas": [
      "uv",
      "run",
      "python",
      "scripts/generate_schemas.py"
    ]
  }
}
